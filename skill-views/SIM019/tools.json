{
  "tools": [
    {
      "name": "preview_export",
      "description": "Review data extraction parameters and validate export schema plan.",
      "inputSchema": {
        "properties": {
          "report_id": {
            "default": "REPORT-001",
            "title": "Report Id",
            "type": "string"
          },
          "view": {
            "default": "summary",
            "enum": [
              "summary",
              "detail"
            ],
            "title": "View",
            "type": "string"
          }
        },
        "title": "preview_exportArguments",
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false
      }
    },
    {
      "name": "list_reports",
      "description": "List exportable report identifiers ready for publication or download.",
      "inputSchema": {
        "properties": {},
        "title": "list_reportsArguments",
        "type": "object"
      },
      "outputSchema": {
        "properties": {
          "result": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "title": "Result",
            "type": "array"
          }
        },
        "required": [
          "result"
        ],
        "title": "list_reportsOutput",
        "type": "object"
      }
    },
    {
      "name": "describe_reports",
      "description": "Describe report rendering capabilities and supported document formats.",
      "inputSchema": {
        "properties": {},
        "title": "describe_reportsArguments",
        "type": "object"
      }
    },
    {
      "name": "validate_report_id",
      "description": "Check export report token validity and schema structure.",
      "inputSchema": {
        "properties": {
          "report_id": {
            "default": "REPORT-001",
            "title": "Report Id",
            "type": "string"
          }
        },
        "title": "validate_report_idArguments",
        "type": "object"
      }
    },
    {
      "name": "export_reports_schema",
      "description": "Export exportable document schema metadata for the reporting pipeline.",
      "inputSchema": {
        "properties": {},
        "title": "export_reports_schemaArguments",
        "type": "object"
      }
    },
    {
      "name": "ping_reports_node",
      "description": "Check responsiveness of the report generation cluster node.",
      "inputSchema": {
        "properties": {},
        "title": "ping_reports_nodeArguments",
        "type": "object"
      }
    }
  ]
}
